{
  "version": "1.0.0",
  "spacing": {
    "none": 0,
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "xxxl": 48
  },
  "radius": {
    "none": 0,
    "xs": 4,
    "sm": 6,
    "md": 8,
    "lg": 12,
    "xl": 20,
    "pill": 999
  },
  "border": {
    "hairline": 0.5,
    "thin": 1,
    "thick": 2
  },
  "opacity": {
    "hover": 0.04,
    "pressed": 0.08,
    "disabled": 0.38,
    "scrim": 0.5,
    "muted": 0.6
  },
  "iconSize": {
    "sm": 16,
    "md": 20,
    "lg": 24,
    "xl": 32
  },
  "elevation": {
    "none": { "y": 0, "blur": 0, "spread": 0, "alphaLight": 0, "alphaDark": 0 },
    "low": { "y": 1, "blur": 3, "spread": 0, "alphaLight": 0.08, "alphaDark": 0.32 },
    "medium": { "y": 4, "blur": 12, "spread": -2, "alphaLight": 0.1, "alphaDark": 0.4 },
    "high": { "y": 12, "blur": 28, "spread": -4, "alphaLight": 0.14, "alphaDark": 0.48 }
  },
  "duration": {
    "instant": 0,
    "fast": 120,
    "normal": 200,
    "slow": 320,
    "slower": 500
  },
  "curve": {
    "standard": "easeOutCubic",
    "decelerate": "decelerate",
    "emphasised": "easeInOutCubicEmphasized",
    "linear": "linear"
  },
  "motion": {
    "tap": { "duration": "fast", "curve": "standard" },
    "reveal": { "duration": "normal", "curve": "standard" },
    "page": { "duration": "normal", "curve": "decelerate" },
    "sheet": { "duration": "slow", "curve": "emphasised" }
  },
  "colorAlias": {
    "surface": "card",
    "surfaceBackground": "artboardColor",
    "surfaceMuted": "gray",
    "onSurface": "black",
    "onSurfaceMuted": "textGrayDark",
    "onSurfaceSubtle": "textGray",
    "border": "stroke",
    "borderSubtle": "whiteStroke",
    "accent": "primary",
    "accentSecondary": "secondary",
    "onAccent": "onAccent",
    "danger": "error",
    "dangerSurface": "errorBg",
    "success": "success",
    "successSurface": "successBg",
    "warning": "warning",
    "warningSurface": "warningBg",
    "navSurface": "navbar",
    "navSurfaceSelected": "navbarSelected"
  },
  "colorRole": {
    "focusRing": { "light": "#2563EB", "dark": "#4B8BF5" },
    "scrim": { "light": "#000000", "dark": "#000000" },
    "surfaceSunken": { "light": "#F1F1F1", "dark": "#181818" },
    "surfaceRaised": { "light": "#FFFFFF", "dark": "#242424" },
    "borderStrong": { "light": "#9AA0A6", "dark": "#5A5A5A" },
    "infoFg": { "light": "#3F84C4", "dark": "#7FB2DE" },
    "infoBg": { "light": "#ECF3F9", "dark": "#1A2A3A" },
    "skeletonBase": { "light": "#ECECEC", "dark": "#2A2A2A" },
    "skeletonHighlight": { "light": "#F7F7F7", "dark": "#343434" }
  }
}
