# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Read through Env (lib/app/core/config/env.dart). BASE_URL and DEV_BASE_URL are
# required: startup aborts with a clear message if either is missing.

# Production REST host, used in release builds.
BASE_URL=https://api.example.com

# Non-prod REST host, used by the dev and staging flavors.
DEV_BASE_URL=https://dev-api.example.com

# Base for relative image paths returned by the API.
IMAGE_URL=https://cdn.example.com

# Production websocket host.
SOCKET_URL=wss://socket.example.com

# Non-prod websocket host.
SOCKET_URL_DEV=wss://dev-socket.example.com

# Optional second backend, selected with ApiService(secondaryBaseUrl: true).
SECONDARY_BASE_URL=
DEV_SECONDARY_BASE_URL=

# Google Maps/Places/Geocoding key — only the location_picker module reads it.
GOOGLE_MAPS_API_KEY_ALL_IN_ONE=

# Publishable (not secret) Stripe key; unused by the template, wire it up yourself.
STRIPE_PUBLISHABLE_KEY=
